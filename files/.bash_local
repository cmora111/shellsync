export PICO_SDK_PATH=/home/mora/Projects/RaspberryPi/Pico/pico/pico-sdk
export PICO_EXAMPLES_PATH=/home/mora/Projects/RaspberryPi/Pico/pico/pico-examples
export PICO_EXTRAS_PATH=/home/mora/Projects/RaspberryPi/Pico/pico/pico-extras
export PICO_PLAYGROUND_PATH=/home/mora/Projects/RaspberryPi/Pico/pico/pico-playground
export SYSTEMD_EDITOR=vim
export PRINTER="OfficeJet_4650_2"
export GCM_CREDENTIAL_STORE=gpgexport GCM_CREDENTIAL_STORE=gpg

#-------------------------------------------------------------------------------#
#                                                                               #
# platform.io                                                                   #
#                                                                               #
#-------------------------------------------------------------------------------#

# BEGIN SNIPPET: Platform.sh CLI configuration
HOME=${HOME:-'/home/mora'}
export PATH="$HOME/"'.platformsh/bin':"$PATH"
if [ -f "$HOME/"'.platformsh/shell-config.rc' ]; then . "$HOME/"'.platformsh/shell-config.rc'; fi # END SNIPPET



